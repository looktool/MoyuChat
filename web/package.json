{
  "name": "moyu-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MoyuChat Web 前端（React + TDesign），通过 WebSocket 桥接复用 Python 服务器",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "esbuild smoke/smoke.tsx --bundle --platform=node --format=esm --external:jsdom --jsx=automatic --target=node18 --outfile=smoke/smoke.mjs && node smoke/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tdesign-react": "^1.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
